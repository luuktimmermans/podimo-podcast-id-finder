  }
</style>

<script>
  import htmx from "htmx.org";

  const input = document.querySelector<HTMLInputElement>("#q");
  const placeholder = document.querySelector<HTMLElement>("#q-placeholder");
  const localeInput = document.querySelector<HTMLInputElement>("#locale");
  const localeField = document.querySelector<HTMLInputElement>("#search [name=locale]");
  const lookup = document.getElementById("lookup");
  const result = document.getElementById("result");
  const emptyResult = document.querySelector<HTMLTemplateElement>("#empty-result");

  const getParam = (name: string) => new URL(location.href).searchParams.get(name) || "";

  const buildUrl = (q: string) => {
    const params = new URLSearchParams({ locale: localeInput.value });
    if (q) params.set("q", q);
    return `/?${params}`;
  };

  // Highlights the trending tile that matches the current result
  const markActive = () => {
    const slug = result.querySelector<HTMLElement>("[data-slug]")?.dataset.slug;
    document.querySelectorAll<HTMLElement>(".trending [data-slug]").forEach((tile) => tile.toggleAttribute("data-active", tile.dataset.slug === slug));
  };

  const showEmpty = () => {
    result.replaceChildren(emptyResult.content.cloneNode(true));
    markActive();
  };

  const clearResult = () => {
    showEmpty();
    input.value = "";
    if (getParam("q")) history.pushState(null, "", buildUrl(""));
  };

  // Region picker: a listbox with keyboard support (arrows, Home/End, type-ahead, Enter, Escape)
  const regionButton = document.getElementById("region-button");
  const regionName = document.getElementById("region-name");
  const regionList = document.getElementById("region-list");
  const regionOptions = [...regionList.querySelectorAll<HTMLElement>("[role=option]")];
  let activeOption: HTMLElement | undefined;

  const setActive = (option: HTMLElement | undefined) => {
    activeOption?.removeAttribute("data-active");
    activeOption = option;
    if (!option) return;
    option.setAttribute("data-active", "");
    regionList.setAttribute("aria-activedescendant", option.id);
    option.scrollIntoView({ block: "nearest" });
  };

  // Shows every region when it fits on screen: opens below the button, flips above when there's more room there,
  // and only scrolls when neither side can fit the whole list
  const placeRegions = () => {
    const gap = 12;
    const margin = 16;
    const button = regionButton.getBoundingClientRect();
    const spaceBelow = innerHeight - button.bottom - gap - margin;
    const spaceAbove = button.top - gap - margin;

    regionList.style.maxHeight = "";
    const fullHeight = regionList.scrollHeight + 2;
    const side = fullHeight > spaceBelow && spaceAbove > spaceBelow ? "top" : "bottom";

    regionList.dataset.side = side;
    regionList.style.left = `${regionButton.offsetLeft}px`;
    regionList.style.maxHeight = `${Math.max(Math.min(fullHeight, side === "top" ? spaceAbove : spaceBelow), 120)}px`;
  };

  const openRegions = () => {
    placeRegions();
    regionList.setAttribute("data-open", "");
    regionButton.setAttribute("aria-expanded", "true");
    setActive(regionOptions.find((option) => option.dataset.locale === localeInput.value));
    regionList.focus({ preventScroll: true });
  };

  const closeRegions = (focusButton = true) => {
    regionList.removeAttribute("data-open");
    regionButton.setAttribute("aria-expanded", "false");
    setActive(undefined);
    if (focusButton) regionButton.focus();
  };

  // Updates the picker and reloads the trending list through htmx on the hidden input
  const setRegion = (locale: string) => {
    const option = regionOptions.find((item) => item.dataset.locale === locale);
    if (!option || locale === localeInput.value) return;
    regionOptions.forEach((item) => item.setAttribute("aria-selected", String(item === option)));
    regionName.textContent = option.textContent.trim();
    localeInput.value = locale;
    htmx.trigger(localeInput, "change");
  };

  addEventListener("resize", () => regionList.hasAttribute("data-open") && placeRegions());

  regionButton.addEventListener("click", () => (regionList.hasAttribute("data-open") ? closeRegions() : openRegions()));

  regionButton.addEventListener("keydown", (event) => {
    if (["ArrowDown", "ArrowUp", "Enter", " "].includes(event.key)) {
      event.preventDefault();
      openRegions();
    }
  });

  regionList.addEventListener("click", (event) => {
    const option = (event.target as HTMLElement).closest<HTMLElement>("[role=option]");
    if (!option) return;
    setRegion(option.dataset.locale);
    closeRegions();
  });

  regionList.addEventListener("mousemove", (event) => {
    const option = (event.target as HTMLElement).closest<HTMLElement>("[role=option]");
    if (option && option !== activeOption) setActive(option);
  });

  regionList.addEventListener("keydown", (event) => {
    const index = regionOptions.indexOf(activeOption);
    const moves: Record<string, number> = { ArrowDown: index + 1, ArrowUp: index - 1, Home: 0, End: regionOptions.length - 1 };

    if (event.key in moves) {
      event.preventDefault();
      setActive(regionOptions[Math.min(Math.max(moves[event.key], 0), regionOptions.length - 1)]);
    } else if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      if (activeOption) setRegion(activeOption.dataset.locale);
      closeRegions();
    } else if (event.key === "Escape") {
      // Keep Escape from also clearing the result
      event.stopPropagation();
      closeRegions();
    } else if (event.key === "Tab") {
      closeRegions(false);
    } else if (event.key.length === 1) {
      // Type-ahead: jump to the next region starting with the typed letter
      const letter = event.key.toLowerCase();
      const next = [...regionOptions.slice(index + 1), ...regionOptions.slice(0, index + 1)].find((option) => option.textContent.trim().toLowerCase().startsWith(letter));
      setActive(next);
    }
  });

  document.addEventListener("click", (event) => {
    if (regionList.hasAttribute("data-open") && !(event.target as HTMLElement).closest("#region")) closeRegions(false);
  });

  // Switching region reloads the trending list and is remembered for next time
  localeInput.addEventListener("change", () => {
    localeField.value = localeInput.value;
    document.cookie = `locale=${localeInput.value}; path=/; max-age=31536000; samesite=lax`;
    history.replaceState(null, "", buildUrl(getParam("q")));
  });

  document.body.addEventListener("htmx:beforeRequest", (event: CustomEvent) => {
    const tile = (event.detail.elt as HTMLElement).closest<HTMLElement>("[data-title]");
    if (!tile) return;

    // Clicking a trending podcast fills in the search and brings the result into view
    input.value = tile.dataset.title;
    if (lookup.getBoundingClientRect().top < 0 || lookup.getBoundingClientRect().top > innerHeight / 2) {
      lookup.scrollIntoView({ behavior: "smooth" });
    }
  });

  document.body.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;

    if (target.closest(".clear")) {
      clearResult();
      input.focus();
      return;
    }

    const copy = target.closest<HTMLElement>(".copy");
    if (copy) {
      await navigator.clipboard.writeText(copy.dataset.copy);
      const label = copy.querySelector(".label");
      copy.classList.add("copied");
      label.textContent = "Copied";

      setTimeout(() => {
        copy.classList.remove("copied");
        label.textContent = "Copy";
      }, 2000);
    }
  });

  // The browser closes the About popover on Escape before our keydown runs, so track it via toggle (which fires afterwards)
  let popoverOpen = false;
  document.addEventListener("toggle", (event) => (popoverOpen = (event as ToggleEvent).newState === "open"), true);

  document.addEventListener("keydown", (event) => {
    // Escape closes the About popover first, and only clears the result on the next press
    if (event.key === "Escape" && result.querySelector(".clear") && !popoverOpen) {
      clearResult();
    } else if (event.key === "/" && document.activeElement !== input) {
      event.preventDefault();
      input.focus();
    }
  });

  // Keep the result and region in sync with the back and forward buttons
  addEventListener("popstate", () => {
    const q = getParam("q");
    const locale = getParam("locale");
    input.value = q;

    if (locale) setRegion(locale);

    if (q) {
      htmx.ajax("GET", "/podcast", { target: "#result", values: { q, locale: localeInput.value }, indicator: "#lookup" });
    } else {
      showEmpty();
    }
  });

  // Suggestion chips wrap onto a clipped second row when they don't fit; take those out of the tab order so focus can't scroll them into view
  const hideWrappedSuggestions = () => {
    const chips = [...result.querySelectorAll<HTMLElement>(".suggestions > *")];
    chips.forEach((chip) => (chip.hidden = false));
    chips.forEach((chip) => (chip.hidden = chip.offsetTop > chips[0].offsetTop));
  };

  hideWrappedSuggestions();
  addEventListener("resize", () => requestAnimationFrame(hideWrappedSuggestions));

  let placeholderTimer: ReturnType<typeof setInterval>;

  document.body.addEventListener("htmx:afterSettle", (event: CustomEvent) => {
    const elt = event.detail.elt as HTMLElement;

    // Put the podcast in the address bar so the result can be shared
    const slug = result.querySelector<HTMLElement>("[data-slug]")?.dataset.slug;
    if (elt === result && slug && slug !== getParam("q")) history.pushState(null, "", buildUrl(slug));

    markActive();
    hideWrappedSuggestions();

    // Cycle the search placeholder through the trending podcasts
    if (elt.classList.contains("trending")) {
      const titles = [...document.querySelectorAll<HTMLElement>(".trending [data-title]")].map((element) => element.dataset.title);
      let index = 0;
      clearInterval(placeholderTimer);
      placeholderTimer = setInterval(() => {
        input.placeholder = placeholder.textContent = `Try “${titles[index++ % titles.length]}”`;
      }, 2500);
    }
  });
</script>
