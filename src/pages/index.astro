---
import Result from "../components/Result.astro";
import Layout from "../layouts/Layout.astro";
import { getRegions, resolveLocale } from "../lib/podimo";

const q = Astro.url.searchParams.get("q") || "";
const regions = await getRegions();
const locale = resolveLocale(regions, Astro.url, Astro.cookies.get("locale")?.value, Astro.request.headers.get("accept-language"));
---

<Layout title="Podimo Podcast ID Finder" description="Find a Podimo Podcast ID by name or URL.">
  <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">
    <a href="/" class="flex items-center gap-2 font-mono text-sm text-neutral-400 transition-colors hover:text-white">
      <span class="h-2 w-2 rounded-full bg-lime-300"></span>
      podimo<span class="text-neutral-700">/</span>id-finder
    </a>
    <a href="https://luuktimmermans.lt" target="_blank" title="By Luuk Timmermans" class="group">
      <svg class="h-auto fill-neutral-600 transition-colors group-hover:fill-white" width="14" viewBox="0 0 17 30" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6.46703 2.14892C6.42291 2.14892 6.3788 2.13786 6.33468 2.11573C5.56263 1.87229 4.9119 2.45875 4.38249 3.87509C3.91926 5.13652 3.66559 6.48648 3.62147 7.92495C3.53324 11.7535 4.2722 15.7259 5.83836 19.8422C6.38982 18.0053 6.81997 16.1243 7.12879 14.1989C7.45967 12.2736 7.63614 10.6691 7.65819 9.38556C7.68025 7.85856 7.53687 6.27624 7.22805 4.63859C7.02952 3.57633 6.78688 2.77964 6.50012 2.24851L6.46703 2.14892ZM0.279593 28.5726C0.279593 28.2849 0.378856 28.0525 0.577384 27.8755C1.83472 26.8796 2.98177 25.5407 4.01853 23.8588C3.42294 22.7523 2.92662 21.5462 2.52957 20.2405C1.47076 16.766 1.0737 13.0039 1.33841 8.95401C1.4487 7.40489 1.77958 5.78937 2.33104 4.10746C2.70604 3.0452 3.11412 2.19318 3.55529 1.5514C4.17294 0.666189 4.87881 0.15719 5.67292 0.0244085C6.40085 -0.0862433 7.01849 0.179321 7.52584 0.821102C8.80524 1.48501 9.58832 2.75751 9.87508 4.63859C10.0295 5.5902 10.0295 7.19465 9.87508 9.45195C9.58832 13.9223 8.59568 18.0607 6.89717 21.8671L6.79791 22.1327C7.5479 23.7924 8.40819 25.3194 9.37877 26.7136C9.53318 26.9571 9.55523 27.2116 9.44494 27.4771C9.62141 27.5878 9.80891 27.6984 10.0074 27.8091C10.206 27.9197 10.3383 28.0857 10.4045 28.307C10.4707 28.5283 10.4486 28.7386 10.3383 28.9377C10.228 29.1369 10.0626 29.2697 9.842 29.3361C9.62141 29.4025 9.41185 29.3803 9.21332 29.2697C7.66922 28.4509 6.32365 27.2669 5.1766 25.7178C3.98544 27.8644 2.65089 29.2697 1.17297 29.9336C0.974439 30.0221 0.764882 30.0221 0.544296 29.9336C0.32371 29.8672 0.1693 29.7234 0.0810654 29.5021C-0.0733448 29.148 -0.00716904 28.8382 0.279593 28.5726Z"></path>
        <path d="M9.64864 9.61793C10.2442 9.37449 10.9722 9.03147 11.8324 8.58886L12.9905 7.99134L13.0567 7.92495V7.62619C12.9905 5.5902 12.9574 4.3177 12.9574 3.8087C12.9574 3.54314 13.0567 3.3329 13.2552 3.17799V2.54727C13.2552 2.32597 13.3324 2.13786 13.4868 1.98295C13.6633 1.8059 13.8618 1.71738 14.0824 1.71738C14.303 1.71738 14.4905 1.8059 14.6449 1.98295C14.8214 2.13786 14.9096 2.32597 14.9096 2.54727C14.9096 3.67592 14.9206 5.05907 14.9427 6.69672L15.4059 6.43115C15.6045 6.3205 15.814 6.29837 16.0346 6.36476C16.2552 6.43115 16.4206 6.56393 16.5309 6.76311C16.6192 6.94015 16.6412 7.12826 16.5971 7.32743C16.6853 7.70365 16.575 7.99134 16.2662 8.19052L14.9758 9.0536C15.1081 15.7591 14.9537 20.9265 14.5126 24.5559C14.4905 24.7551 14.4023 24.9211 14.2479 25.0539C14.1155 25.1866 13.9611 25.2641 13.7846 25.2862C13.6082 25.6182 13.3435 25.7731 12.9905 25.751C12.7699 25.751 12.5824 25.6624 12.428 25.4854C12.2736 25.3084 12.1964 25.1092 12.1964 24.8879C12.1964 24.8436 12.2185 23.4715 12.2626 20.7716C12.3067 19.0897 12.3839 17.6844 12.4942 16.5558L12.9243 12.9707C12.9905 12.3953 13.0346 11.8531 13.0567 11.3441C13.0787 11.0121 13.0898 10.6802 13.0898 10.3482L10.4427 12.174C10.2442 12.3068 10.0347 12.3621 9.81408 12.34C9.59349 12.2957 9.41702 12.185 9.28467 12.008C9.01997 11.6318 9.04203 11.2777 9.35085 10.9457C9.28467 10.8794 9.22952 10.7908 9.18541 10.6802C9.09717 10.481 9.09717 10.2818 9.18541 10.0827C9.27364 9.86136 9.42805 9.70645 9.64864 9.61793Z"></path>
      </svg>
    </a>
  </header>

  <main class="mx-auto max-w-7xl px-6">
    <section class="grid grid-cols-1 gap-10 pt-12 pb-10 md:py-24 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <h1 class="animate-rise text-5xl leading-[0.95] font-semibold tracking-tighter text-balance md:text-7xl">
        Find any Podimo podcast <span class="text-lime-300">ID.</span>
      </h1>
      <div class="grid min-w-0 animate-rise grid-cols-1 gap-6 [animation-delay:80ms]">
        <p class="text-neutral-400 md:text-lg">Search by name or paste a Podimo link. You'll get the podcast ID, ready to copy, plus the artwork and description.</p>
        <form action="/" id="search" class="group/form" hx-get="/podcast" hx-target="#result" hx-indicator="#lookup, #search">
          <label for="q" class="flex items-center gap-3 border-b border-neutral-800 pb-3 transition-colors focus-within:border-lime-300">
            <span class="relative min-w-0 flex-1 text-xl md:text-2xl">
              <input type="text" id="q" name="q" placeholder="Search a podcast.." class="peer w-full min-w-0 appearance-none bg-transparent text-white placeholder-transparent outline-none" autocomplete="off" value={q} required />
              <span id="q-placeholder" class="pointer-events-none absolute inset-0 truncate text-neutral-600 peer-not-placeholder-shown:hidden" aria-hidden="true">
                Search a podcast..
              </span>
            </span>
            <kbd class="hidden shrink-0 rounded border border-neutral-800 px-1.5 font-mono text-xs text-neutral-500 group-focus-within/form:hidden sm:block">/</kbd>
            <button class="grid h-10 w-10 shrink-0 cursor-pointer place-content-center rounded-full bg-lime-300 text-black transition-all hover:bg-lime-200 active:scale-90" title="Search">
              <svg class="h-5 w-5 group-[.htmx-request]/form:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
              <svg class="hidden h-5 w-5 animate-spin group-[.htmx-request]/form:block" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>
          </label>
          <input type="hidden" name="locale" value={locale} />
        </form>
        <!-- Fixed height, so swapping between the empty state, loading, a result or an error never moves the page. The full description opens in a popover -->
        <div id="lookup" class="group/lookup h-40 scroll-mt-6">
          <div class="hidden h-full animate-pulse flex-col justify-between rounded-2xl border border-neutral-800 p-4 group-[.htmx-request]/lookup:flex" aria-hidden="true">
            <div class="flex items-center gap-3">
              <div class="h-16 w-16 rounded-lg bg-neutral-900"></div>
              <div class="grid flex-1 gap-2">
                <div class="h-5 w-1/2 rounded bg-neutral-900"></div>
                <div class="h-4 w-1/3 rounded bg-neutral-900"></div>
              </div>
            </div>
            <div class="h-[50px] rounded-xl bg-neutral-900"></div>
          </div>
          <div id="result" class="h-full group-[.htmx-request]/lookup:hidden" aria-live="polite">
            <Result q={q} locale={locale} />
          </div>
          <template id="empty-result">
            <Result q="" locale={locale} />
          </template>
        </div>
      </div>
    </section>

    <section class="border-neutral-900 pb-10 lg:border-t lg:pt-10">
      <div class="mb-8 flex items-baseline justify-between gap-4">
        <div id="region" class="relative">
          <h2 class="flex items-baseline gap-1.5 text-lg font-medium">
            Trending in
            <button id="region-button" type="button" class="group inline-flex cursor-pointer items-center gap-1 rounded text-lime-300" aria-haspopup="listbox" aria-expanded="false" aria-controls="region-list" title="Change region">
              <span id="region-name" class="underline decoration-lime-300/30 underline-offset-4 transition-colors group-hover:decoration-lime-300">
                {regions.find((region) => region.locale === locale)?.name}
              </span>
              <svg class="h-4 w-4 translate-y-px transition-transform group-aria-expanded:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
          </h2>
          <ul id="region-list" role="listbox" tabindex="-1" aria-label="Podimo region" class="invisible absolute top-full z-30 mt-3 w-56 origin-top-left scale-95 overflow-y-auto overscroll-contain data-[side=top]:top-auto data-[side=top]:bottom-full data-[side=top]:mt-0 data-[side=top]:mb-3 data-[side=top]:origin-bottom-left rounded-xl border border-neutral-800 bg-neutral-900/95 p-1 opacity-0 shadow-2xl shadow-black/60 backdrop-blur-xl transition duration-150 outline-none data-open:visible data-open:scale-100 data-open:opacity-100">
            {regions.map((region) => (
              <li id={`region-${region.locale}`} role="option" aria-selected={region.locale === locale ? "true" : "false"} data-locale={region.locale} class="group flex cursor-pointer items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm text-neutral-300 transition-colors hover:bg-neutral-800 hover:text-white aria-selected:text-white data-active:bg-neutral-800 data-active:text-white in-data-[input=keyboard]:data-active:bg-lime-300/10 in-data-[input=keyboard]:data-active:text-lime-200 in-data-[input=keyboard]:data-active:ring-1 in-data-[input=keyboard]:data-active:ring-lime-300/40 in-data-[input=keyboard]:data-active:ring-inset">
                {region.name}
                <svg class="h-4 w-4 text-lime-300 opacity-0 group-aria-selected:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </li>
            ))}
          </ul>
          <input type="hidden" id="locale" name="locale" value={locale} hx-get="/trending" hx-trigger="change" hx-target=".trending" hx-indicator=".trending" />
        </div>
        <span class="flex items-center gap-2 font-mono text-xs text-neutral-500">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-lime-300"></span>
          <span class="hidden sm:inline">live from Podimo</span>
        </span>
      </div>
      <div class="trending transition-opacity [&.htmx-request]:opacity-40" hx-get={`/trending?locale=${locale}`} hx-trigger="load">
        <ol class="grid animate-pulse grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6" aria-hidden="true">
          {Array.from({ length: 12 }, () => (
            <li class="grid gap-3">
              <span class="aspect-square rounded-xl bg-neutral-900" />
              <span class="flex h-9 gap-3">
                <span class="h-4 w-4 rounded bg-neutral-900" />
                <span class="grid flex-1 content-between">
                  <span class="h-4 w-3/4 rounded bg-neutral-900" />
                  <span class="h-3 w-1/2 rounded bg-neutral-900" />
                </span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-7xl px-6 py-10 text-xs text-neutral-600">Not affiliated with Podimo.</footer>
</Layout>

<style is:global>
  #result {
    & .icon {
      content: url("data:image/svg+xml,%3Csvg width='12' height='14' viewBox='0 0 12 14' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8.60002 10.6V11.8C8.60002 12.1183 8.4736 12.4235 8.24855 12.6485C8.02351 12.8736 7.71828 13 7.40002 13H2.60002C2.28176 13 1.97654 12.8736 1.7515 12.6485C1.52645 12.4235 1.40002 12.1183 1.40002 11.8V5.2C1.40002 4.88174 1.52645 4.57652 1.7515 4.35147C1.97654 4.12643 2.28176 4 2.60002 4H3.80002M3.80002 2.2V9.4C3.80002 9.71826 3.92645 10.0235 4.1515 10.2485C4.37654 10.4736 4.68176 10.6 5.00002 10.6H9.80002C10.1183 10.6 10.4235 10.4736 10.6486 10.2485C10.8736 10.0235 11 9.71826 11 9.4V4.1452C11 3.98534 10.968 3.82709 10.906 3.67975C10.844 3.53241 10.7531 3.39894 10.6388 3.2872L8.64982 1.342C8.42564 1.12279 8.12457 1.00004 7.81102 1H5.00002C4.68176 1 4.37654 1.12643 4.1515 1.35147C3.92645 1.57652 3.80002 1.88174 3.80002 2.2Z' stroke='%23000' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E%0A");
    }
    & .copied .icon {
      content: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 14 14' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6.02 8.26L4.515 6.755C4.38667 6.62667 4.22333 6.5625 4.025 6.5625C3.82667 6.5625 3.66333 6.62667 3.535 6.755C3.40667 6.88333 3.3425 7.04667 3.3425 7.245C3.3425 7.44333 3.40667 7.60667 3.535 7.735L5.53 9.73C5.67 9.87 5.83333 9.94 6.02 9.94C6.20667 9.94 6.37 9.87 6.51 9.73L10.465 5.775C10.5933 5.64667 10.6575 5.48333 10.6575 5.285C10.6575 5.08667 10.5933 4.92333 10.465 4.795C10.3367 4.66667 10.1733 4.6025 9.975 4.6025C9.77667 4.6025 9.61333 4.66667 9.485 4.795L6.02 8.26ZM7 14C6.03167 14 5.12167 13.8161 4.27 13.4484C3.41833 13.0807 2.6775 12.582 2.0475 11.9525C1.4175 11.3225 0.918867 10.5817 0.5516 9.73C0.184333 8.87833 0.000466667 7.96833 0 7C0 6.03167 0.183867 5.12167 0.5516 4.27C0.919333 3.41833 1.41797 2.6775 2.0475 2.0475C2.6775 1.4175 3.41833 0.918867 4.27 0.5516C5.12167 0.184333 6.03167 0.000466667 7 0C7.96833 0 8.87833 0.183867 9.73 0.5516C10.5817 0.919333 11.3225 1.41797 11.9525 2.0475C12.5825 2.6775 13.0814 3.41833 13.4491 4.27C13.8168 5.12167 14.0005 6.03167 14 7C14 7.96833 13.8161 8.87833 13.4484 9.73C13.0807 10.5817 12.582 11.3225 11.9525 11.9525C11.3225 12.5825 10.5817 13.0814 9.73 13.4491C8.87833 13.8168 7.96833 14.0005 7 14Z' fill='%23000'/%3E%3C/svg%3E%0A");
