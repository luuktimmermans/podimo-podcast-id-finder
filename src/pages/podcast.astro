---
import Result from "../components/Result.astro";
import { getRegions, resolveLocale } from "../lib/podimo";

const q = Astro.url.searchParams.get("q") || "";
const regions = await getRegions();
const locale = resolveLocale(regions, Astro.url, Astro.cookies.get("locale")?.value, Astro.request.headers.get("accept-language"));

export const partial = true;
---

<Result q={q} locale={locale} />
